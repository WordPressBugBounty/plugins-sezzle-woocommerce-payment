#: woocommerce-gateway-sezzle.php:499
msgid "General"
msgstr "Général"

#: woocommerce-gateway-sezzle.php:504
msgid "Transaction Mode"
msgstr "Mode de transaction"

#: woocommerce-gateway-sezzle.php:514
msgid "Public Key"
msgstr "Clé publique"

#: woocommerce-gateway-sezzle.php:516
#: woocommerce-gateway-sezzle.php:527
msgid "Find under Settings > API Keys in the Sezzle Dashboard that corresponds to the selected Transaction Mode."
msgstr "Disponible sous Paramètres > Clés API dans le tableau de bord Sezzle correspondant au mode de transaction sélectionné."

#: woocommerce-gateway-sezzle.php:525
msgid "Private Key"
msgstr "Clé privée"

#: woocommerce-gateway-sezzle.php:536
msgid "Enable Sezzle"
msgstr "Activer Sezzle"

#: woocommerce-gateway-sezzle.php:538
#: woocommerce-gateway-sezzle.php:561
#: woocommerce-gateway-sezzle.php:733
#: woocommerce-gateway-sezzle.php:739
#: woocommerce-gateway-sezzle.php:750
#: woocommerce-gateway-sezzle.php:790
msgid "Enabled"
msgstr "Activé"

#: woocommerce-gateway-sezzle.php:539
msgid "Enables/Disables the Sezzle payment method"
msgstr "Active ou désactive le mode de paiement Sezzle"

#: woocommerce-gateway-sezzle.php:547
msgid "Minimum Checkout Amount"
msgstr "Montant minimum de commande"

#: woocommerce-gateway-sezzle.php:551
msgid "Hides the payment method below this amount"
msgstr "Masque le mode de paiement en dessous de ce montant"

#: woocommerce-gateway-sezzle.php:559
msgid "Create order post checkout completion"
msgstr "Créer la commande après la finalisation du paiement"

#: woocommerce-gateway-sezzle.php:562
msgid "When enabled, abandoned Sezzle checkouts will not show in WooCommerce order table."
msgstr "Lorsque cette option est activée, les paiements Sezzle abandonnés n’apparaissent pas dans le tableau des commandes WooCommerce."

#: woocommerce-gateway-sezzle.php:592
msgid "Express Checkout"
msgstr "Paiement express"

#: woocommerce-gateway-sezzle.php:597
msgid "Checkout Mode"
msgstr "Mode de paiement"

#: woocommerce-gateway-sezzle.php:600
msgid "For security reasons, Sezzle must add your domain(s) to our Content Security Policy to allow iframe usage."
msgstr "Pour des raisons de sécurité, Sezzle doit ajouter votre ou vos domaines à notre politique de sécurité du contenu (CSP) afin d’autoriser l’utilisation d’iframes."

#: woocommerce-gateway-sezzle.php:608
msgid "No Shipping"
msgstr "Aucune livraison"

#: woocommerce-gateway-sezzle.php:610
msgid "I never ship physical products"
msgstr "Je n’expédie jamais de produits physiques"

#: woocommerce-gateway-sezzle.php:611
msgid "By default, Express Checkout requires shipping options to be configured for your store. Enable this field to bypass this requirement."
msgstr "Par défaut, le paiement express exige que des options de livraison soient configurées pour votre boutique. Activez ce champ pour contourner cette exigence."

#: woocommerce-gateway-sezzle.php:616
msgid "Product Page Button"
msgstr "Bouton de la page produit"

#: woocommerce-gateway-sezzle.php:621
#: woocommerce-gateway-sezzle.php:664
msgid "Enable Button"
msgstr "Activer le bouton"

#: woocommerce-gateway-sezzle.php:623
msgid "Show the Express Checkout button on product pages"
msgstr "Afficher le bouton de paiement express sur les pages produit"

#: woocommerce-gateway-sezzle.php:627
#: woocommerce-gateway-sezzle.php:670
msgid "Container Selector"
msgstr "Sélecteur de conteneur"

#. translators: %s: example CSS selector matching the store's theme
#: woocommerce-gateway-sezzle.php:631
#, php-format
msgid "Class name or CSS selector of the container the Express Checkout button will be rendered inside on the product page (e.g. %s)"
msgstr "Nom de classe ou sélecteur CSS du conteneur dans lequel le bouton de paiement express sera affiché sur la page produit (par ex. %s)"

#: woocommerce-gateway-sezzle.php:638
#: woocommerce-gateway-sezzle.php:681
msgid "Width"
msgstr "Largeur"

#: woocommerce-gateway-sezzle.php:640
msgid "CSS width of the button on the product page (e.g. 100%, fit-content, 250px)."
msgstr "Largeur CSS du bouton sur la page produit (par ex. 100%, fit-content, 250px)."

#: woocommerce-gateway-sezzle.php:645
#: woocommerce-gateway-sezzle.php:688
msgid "Radius"
msgstr "Rayon"

#: woocommerce-gateway-sezzle.php:647
msgid "CSS border-radius of the button on the product page (e.g. 4px)."
msgstr "Rayon de bordure CSS du bouton sur la page produit (par ex. 4px)."

#: woocommerce-gateway-sezzle.php:652
#: woocommerce-gateway-sezzle.php:695
msgid "Margin"
msgstr "Marge"

#: woocommerce-gateway-sezzle.php:654
msgid "CSS margin around the button on the product page (e.g. 10px 0)."
msgstr "Marge CSS autour du bouton sur la page produit (par ex. 10px 0)."

#: woocommerce-gateway-sezzle.php:659
msgid "Cart Page Button"
msgstr "Bouton de la page panier"

#: woocommerce-gateway-sezzle.php:666
msgid "Show the Express Checkout button on the cart page"
msgstr "Afficher le bouton de paiement express sur la page panier"

#. translators: %s: example CSS selector matching the store's cart page
#: woocommerce-gateway-sezzle.php:674
#, php-format
msgid "Class name or CSS selector of the container the Express Checkout button will be rendered inside on the cart page (e.g. %s)"
msgstr "Nom de classe ou sélecteur CSS du conteneur dans lequel le bouton de paiement express sera affiché sur la page panier (par ex. %s)"

#: woocommerce-gateway-sezzle.php:683
msgid "CSS width of the button on the cart page (e.g. 100%, 250px)."
msgstr "Largeur CSS du bouton sur la page panier (par ex. 100%, 250px)."

#: woocommerce-gateway-sezzle.php:690
msgid "CSS border-radius of the button on the cart page (e.g. 4px)."
msgstr "Rayon de bordure CSS du bouton sur la page panier (par ex. 4px)."

#: woocommerce-gateway-sezzle.php:697
msgid "CSS margin around the button on the cart page (e.g. 10px 0)."
msgstr "Marge CSS autour du bouton sur la page panier (par ex. 10px 0)."

#: woocommerce-gateway-sezzle.php:711
msgid "On-Site Messaging"
msgstr "Messagerie sur le site"

#: woocommerce-gateway-sezzle.php:716
msgid "Widgets"
msgstr "Widgets"

#: woocommerce-gateway-sezzle.php:721
msgid "Merchant ID"
msgstr "Identifiant marchand"

#: woocommerce-gateway-sezzle.php:723
msgid "Find under Settings > Business in the Sezzle Production Dashboard, even while testing in Sandbox mode. Saving valid API keys in Live mode will auto-fill your Live Merchant ID."
msgstr "Disponible sous Paramètres > Entreprise dans le tableau de bord de production Sezzle, même lors des tests en mode Bac à sable. L’enregistrement de clés API valides en mode Production remplira automatiquement votre identifiant marchand de production."

#: woocommerce-gateway-sezzle.php:731
msgid "Product Page Widget"
msgstr "Widget de la page produit"

#: woocommerce-gateway-sezzle.php:737
msgid "Cart Page Widget"
msgstr "Widget de la page panier"

#: woocommerce-gateway-sezzle.php:743
msgid "Checkout Installments Plan"
msgstr "Plan de versements à la caisse"

#: woocommerce-gateway-sezzle.php:748
msgid "Enable"
msgstr "Activer"

#: woocommerce-gateway-sezzle.php:768
msgid "Order Total Container Selector"
msgstr "Sélecteur du conteneur du total de la commande"

#. translators: %s: example CSS selector matching the store's checkout
#: woocommerce-gateway-sezzle.php:772
#, php-format
msgid "CSS selector of the checkout order-total element the installment widget attaches to (e.g. %s). Leave blank to fall back to automatic detection."
msgstr "Sélecteur CSS de l’élément du total de commande à la caisse auquel le widget de versements se rattache (par ex. %s). Laissez ce champ vide pour utiliser la détection automatique."

#: woocommerce-gateway-sezzle.php:783
msgid "Logging"
msgstr "Journalisation"

#: woocommerce-gateway-sezzle.php:788
msgid "Sezzle Logs"
msgstr "Journaux Sezzle"

#: woocommerce-gateway-sezzle.php:791
msgid "Resulting logs can be found at WooCommerce > Status > Logs > sezzlepay"
msgstr "Les journaux générés se trouvent sous WooCommerce > État > Journaux > sezzlepay"

#: woocommerce-gateway-sezzle.php:2386
msgid "Sezzle has been disabled because the stored API keys were rejected (unauthorized). Please enter valid Public and Private keys to re-enable Sezzle."
msgstr "Sezzle a été désactivé parce que les clés API enregistrées ont été rejetées (non autorisées). Veuillez saisir des clés publique et privée valides pour réactiver Sezzle."

#: includes/class-sezzle-checkout.php:840
#: woocommerce-gateway-sezzle.php:1164
msgid "Sorry, there was a problem preparing your payment."
msgstr "Désolé, un problème est survenu lors de la préparation de votre paiement."

#: woocommerce-gateway-sezzle.php:1331
#: woocommerce-gateway-sezzle.php:1366
msgid "Order reference ID not matching"
msgstr "L’identifiant de référence de la commande ne correspond pas"

