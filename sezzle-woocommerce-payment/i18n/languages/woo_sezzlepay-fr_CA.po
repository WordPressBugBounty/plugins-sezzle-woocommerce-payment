msgstr "La commande n’est pas au statut « paiement en attente »."

#: woocommerce-gateway-sezzle.php:4321
#: woocommerce-gateway-sezzle.php:4403
msgid "Order details updated successfully."
msgstr "Détails de la commande mis à jour avec succès."

#: woocommerce-gateway-sezzle.php:4469
#: woocommerce-gateway-sezzle.php:4529
msgid "Invalid nonce"
msgstr "Nonce invalide"

#: woocommerce-gateway-sezzle.php:4474
msgid "Missing required parameters"
msgstr "Paramètres requis manquants"

#: woocommerce-gateway-sezzle.php:4496
#: woocommerce-gateway-sezzle.php:4588
msgid "An error occurred. Please try again."
msgstr "Une erreur est survenue. Veuillez réessayer."

#: woocommerce-gateway-sezzle.php:4580
msgid "Verification failed"
msgstr "Échec de la vérification"

#: woocommerce-gateway-sezzle.php:414
msgid "IFrame mode may cause Content Security Policy (CSP) issues. Please reach out to Sezzle support before using it to make sure your domain is allowlisted."
msgstr "Le mode IFrame peut entraîner des problèmes de politique de sécurité du contenu (CSP). Veuillez contacter l’assistance Sezzle avant de l’utiliser afin de vous assurer que votre domaine figure sur la liste d’autorisation."

#: woocommerce-gateway-sezzle.php:870
msgid "Unable to validate keys."
msgstr "Impossible de valider les clés."

#: woocommerce-gateway-sezzle.php:509
msgid "Sandbox"
msgstr "Bac à sable"

#: woocommerce-gateway-sezzle.php:510
msgid "Live"
msgstr "Production"

#: woocommerce-gateway-sezzle.php:603
msgid "Pop Up"
msgstr "Fenêtre surgissante"

#: woocommerce-gateway-sezzle.php:604
msgid "IFrame"
msgstr "Cadre intégré (iFrame)"

#: woocommerce-gateway-sezzle.php:1341
msgid "Unable to find the order for this payment."
msgstr "Impossible de trouver la commande associée à ce paiement."

#: woocommerce-gateway-sezzle.php:1352
msgid "Unable to find the Sezzle checkout for this order."
msgstr "Impossible de trouver le paiement Sezzle associé à cette commande."

#: woocommerce-gateway-sezzle.php:1373
#: woocommerce-gateway-sezzle.php:1756
#: woocommerce-gateway-sezzle.php:4284
msgid "Sezzle was unable to complete your payment. Please try again or choose another payment method."
msgstr "Sezzle n’a pas pu finaliser votre paiement. Veuillez réessayer ou choisir un autre mode de paiement."

#: woocommerce-gateway-sezzle.php:1441
msgid "Your payment is still being processed. Please wait a moment and refresh the page."
msgstr "Votre paiement est toujours en cours de traitement. Veuillez patienter un instant, puis actualiser la page."

#: woocommerce-gateway-sezzle.php:1824
msgid "Sezzle capture result could not be confirmed. Check this order in the Sezzle Merchant Dashboard."
msgstr "Le résultat de l’encaissement Sezzle n’a pas pu être confirmé. Vérifiez cette commande dans le tableau de bord marchand Sezzle."

#: woocommerce-gateway-sezzle.php:1964
msgid "This order has no Sezzle order ID stored against it, so there is nothing to refund."
msgstr "Aucun identifiant de commande Sezzle n’est enregistré pour cette commande. Il n’y a donc rien à rembourser."

#. translators: %s: error message returned by the Sezzle API.
#: woocommerce-gateway-sezzle.php:1988
#, php-format
msgid "Sezzle rejected the refund: %s"
msgstr "Sezzle a refusé le remboursement : %s"

#: woocommerce-gateway-sezzle.php:2009
msgid "Sezzle accepted the request but did not return a refund ID."
msgstr "Sezzle a accepté la demande, mais n’a pas renvoyé d’identifiant de remboursement."

#: woocommerce-gateway-sezzle.php:2388
msgid "Update API keys"
msgstr "Mettre à jour les clés API"

#: woocommerce-gateway-sezzle.php:2390
msgid "Dismiss"
msgstr "Ignorer"

